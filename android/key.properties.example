# Android release signing — COPY to android/key.properties and fill in for a
# store build. android/key.properties is git-ignored (android/.gitignore); NEVER
# commit real keystore paths, passwords, or the .jks/.keystore itself.
#
# Generate an upload keystore:
#   keytool -genkey -v -keystore ~/qalam-upload.jks -keyalg RSA -keysize 2048 \
#     -validity 10000 -alias upload
#
# When android/key.properties is absent, the release build falls back to debug
# signing so `flutter run --release` still works during development.

storePassword=your-keystore-password
keyPassword=your-key-password
keyAlias=upload
storeFile=/absolute/path/to/qalam-upload.jks
